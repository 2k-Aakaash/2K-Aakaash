---
import Base from '../layouts/Base.astro';
---
<Base title="Lost in space · 2K Aakaash" description="This page drifted out of orbit.">
  <main id="main" class="region" style="text-align: left">
    <div class="region-inner">
      <p class="label">404 · Off the map</p>
      <h1 class="display h-section">This page drifted out of orbit.</h1>
      <p class="lead">The observatory is still where you left it.</p>
      <div class="actions"><a class="btn btn-solar" href="/">Back to the observatory</a></div>
    </div>
  </main>
</Base>
